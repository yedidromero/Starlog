{
  "name": "estela-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that lets AI agents find events, pay for flight searches (x402) and book trips with Estela on Stellar.",
  "type": "module",
  "bin": {
    "estela-mcp": "src/index.mjs"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "setup:wallet": "node scripts/setup-test-wallet.mjs",
    "setup:testnet": "node --env-file=.env.local scripts/setup-testnet.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@stellar/stellar-sdk": "^16.4.1",
    "@x402/core": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/stellar": "^2.28.0",
    "zod": "^4.6.7"
  }
}
