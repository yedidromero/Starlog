LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Must match STARLOG_INTERNAL_API_TOKEN in apps/agent/.env.local
STARLOG_INTERNAL_API_TOKEN=replace-with-a-long-random-secret

# Optional Pollar testnet publishable key for the wallet connection UI.
# This key is intended for the browser. Never put a Pollar secret key or MCP PAT here.
NEXT_PUBLIC_POLLAR_API_KEY=

# Starlog MariaDB connection. Keep these values server-side; never add NEXT_PUBLIC_.
STARLOG_DB_HOST=your-database-host
STARLOG_DB_PORT=3306
STARLOG_DB_NAME=starlog_app
STARLOG_DB_USER=starlog_app_user
STARLOG_DB_PASSWORD=replace-with-your-database-password
# TLS is enabled by default. Set false only for a local development database.
STARLOG_DB_SSL=true

# Duffel API test access token. Keep server-side; never use NEXT_PUBLIC_.
DUFFEL_ACCESS_TOKEN=

# Musement partner API sandbox only. Keep these credentials server-side.
# Musement provides them after partner onboarding/contract; sandbox endpoint is hard-coded.
MUSEMENT_CLIENT_ID=
MUSEMENT_CLIENT_SECRET=
MUSEMENT_APPLICATION=
MUSEMENT_MARKET=es
MUSEMENT_CURRENCY=EUR
MUSEMENT_SANDBOX_ORDERS_ENABLED=false
