LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Must match STARLOG_INTERNAL_API_TOKEN in apps/guide-web/.env.local
STARLOG_WEB_API_URL=http://localhost:3001
STARLOG_INTERNAL_API_TOKEN=replace-with-a-long-random-secret

# Optional: absolute path to this repository's mcp directory for Estela x402 search, quotes and testnet booking.
# The MCP directory must have its own ignored .env.local with ESTELA_AGENT_SECRET and ESTELA_URL.
STARLOG_MCP_DIR=/absolute/path/to/Starlog/mcp
